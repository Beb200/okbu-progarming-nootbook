<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cs2.concurrency</groupId>
  <artifactId>week2-demos</artifactId>
  <version>1.0</version>
  <name>Week 2 in-class demos</name>

  <!--
    Run a program (the package prefix is added for you):
        mvn -q compile exec:exec -Dmain=VirtualThreadsDemo
        mvn -q compile exec:exec -Dmain=VirtualThreadsDemo -Dargs="..."
    Run the tests:
        mvn test
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <main>VirtualThreadsDemo</main>
    <args></args>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <!-- exec:exec starts a separate "java" process, so the program behaves
               exactly as it would from the command line (its main thread is "main"). -->
          <executable>java</executable>
          <commandlineArgs>-classpath %classpath concurrency.week2.demos.${main} ${args}</commandlineArgs>
          <inheritIo>true</inheritIo>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
